				            {"HierarchyPath", type text},
				            {"HierarchyDepth", Int64.Type},
				            {"DirectReports", Int64.Type},
				            {"SubtreeEmployeeCount", Int64.Type},
				            {"OfficeLocation", type text},
				            {"OfficeHoursStart", type time},
				            {"OfficeHoursEnd", type time},
				            {"EmploymentType", type text},
				            {"EmploymentStatus", type text},
				            {"DateOfJoining", type date},
				            {"YearsOfService", type number},
				            {"AnnualSalaryINR", Int64.Type},
				            {"MonthlySalaryINR", Int64.Type},
				            {"PerformanceScore", type number},
				            {"AppraisalRating", type text},
				            {"LowPerformerFlag", type logical},
				            {"AttendancePct", type number},
				            {"LeaveDaysYTD", type number},
				            {"OvertimeHoursYTD", type number},
				            {"EngagementScore", type number},
				            {"GoalsAchievedPct", type number},
				            {"TrainingHoursYTD", type number},
				            {"ProjectsAssigned", Int64.Type},
				            {"UtilizationPct", type number},
				            {"AttritionRiskPct", type number},
