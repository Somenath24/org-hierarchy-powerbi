table Employee
	lineageTag: e1a2b3c4-d5e6-4f70-8192-93a4b5c6d7e8

	measure 'Total Employees' = COUNTROWS(Employee)
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-000000000001

	measure 'Total Managers' =
			CALCULATE(
			    COUNTROWS(Employee),
			    Employee[DirectReports] > 0
			)
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-000000000002

	measure 'Total Teams' = DISTINCTCOUNT(Employee[Team])
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-000000000003

	measure 'Average Performance' = AVERAGE(Employee[PerformanceScore])
		formatString: 0.0
		lineageTag: 10000001-0000-0000-0000-000000000004

	measure 'Average Salary' = AVERAGE(Employee[AnnualSalaryINR])
		formatString: \₹#,0
		lineageTag: 10000001-0000-0000-0000-000000000005

	measure 'Average Attendance' = AVERAGE(Employee[AttendancePct])
		formatString: 0.0"%"
		lineageTag: 10000001-0000-0000-0000-000000000006

	measure 'Average Engagement' = AVERAGE(Employee[EngagementScore])
		formatString: 0.0
		lineageTag: 10000001-0000-0000-0000-000000000007

	measure 'Average Goals Achieved' = AVERAGE(Employee[GoalsAchievedPct])
		formatString: 0.0"%"
		lineageTag: 10000001-0000-0000-0000-000000000008

	measure 'Low Performer Count' =
			CALCULATE(
			    COUNTROWS(Employee),
			    Employee[LowPerformerFlag] = TRUE
			)
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-000000000009

	measure 'Promotion Eligible Count' =
			CALCULATE(
			    COUNTROWS(Employee),
			    Employee[PromotionEligible] = TRUE
			)
		formatString: #,0
		lineageTag: 10000001-0000-0000-0000-00000000000a

	measure 'Average Attrition Risk' = AVERAGE(Employee[AttritionRiskPct])
		formatString: 0.0"%"
		lineageTag: 10000001-0000-0000-0000-00000000000b

